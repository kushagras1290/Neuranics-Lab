# Shared optional authentication. Set the same non-empty value for both processes.
MORPHX_API_KEY=

# Central server
MORPHX_SERVER_DB_PATH=./data/server.db
MORPHX_SERVER_HOST=0.0.0.0
MORPHX_SERVER_PORT=8000
# Optional Docker Compose host-port override; the container still listens on 8000.
MORPHX_HOST_PORT=8000

# Device agent
MORPHX_DEVICE_ID=MORPHX_SIM_001
MORPHX_AGENT_DB_PATH=./data/agent.db
MORPHX_SERVER_URL=http://127.0.0.1:8000
MORPHX_INTERVAL_SECONDS=5
MORPHX_SYNC_POLL_SECONDS=1
MORPHX_SYNC_BATCH_SIZE=100
MORPHX_REQUEST_TIMEOUT_SECONDS=5
MORPHX_RETRY_BASE_SECONDS=1
MORPHX_RETRY_MAX_SECONDS=60

# Both processes
MORPHX_LOG_LEVEL=INFO
